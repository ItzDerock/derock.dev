---
import { Image } from "astro:assets";
import LinkArrow from "../../components/ui/LinkArrow.astro";
import LinkExternal from "../../components/ui/LinkExternal.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProfileLayout from "../../layouts/ProfileLayout.astro";
import { stringToHexColor } from "../../utils";
import "../../styles/post.css";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("projects");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<"projects">;
const entry = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
---

<ProfileLayout
  title={`Project - ${entry.data.title}`}
  description={entry.data.description}
  thumbnail={entry.data.heroImage.src}
>
  <div slot="subtitle">
    <p class="text-lg text-text-light dark:text-text-dark text-balance">
      {entry.data.blurb}
    </p>

    <!-- tags -->
    <div class="flex flex-row flex-wrap gap-2 mt-4">
      {
        entry.data.tags
          .map((tag) => [tag, stringToHexColor(tag)])
          .map(([tag, hex]) => (
            <span
              class="px-3 py-1 rounded-full text-sm font-medium border"
              style={{
                backgroundColor: hex + "35",
                borderColor: hex + "a0",
              }}
            >
              {tag}
            </span>
          ))
      }
    </div>
  </div>

  <div class="max-w-[min(90vw,65ch)]" data-sal="fade-up">
    <h1 class="text-4xl md:text-5xl font-bold mb-4 wrap-break-word">
      {entry.data.title}
    </h1>

    <div class="flex flex-row mb-2 -ml-1.25">
      {
        entry.data.links.map(([label, url]) => (
          <LinkExternal target="_blank" href={url} data-astro-preload>
            {label}
          </LinkExternal>
        ))
      }
    </div>

    <div class="prose prose-invert lg:prose-md max-w-none">
      <Content remarkPluginFrontmatter={remarkPluginFrontmatter} />
    </div>

    <div class="px-4 md:px-12">
      <Image
        src={entry.data.heroImage}
        alt={entry.data.title}
        class="my-8 rounded-lg shadow-lg mx-auto"
      />
    </div>

    <div class="text-right">
      <LinkArrow href="/projects" class="mb-4" data-astro-preload>
        Back to all projects
      </LinkArrow>
    </div>
  </div>
</ProfileLayout>
