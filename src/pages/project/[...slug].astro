---
import { Image } from "astro:assets";
import LinkArrow from "../../components/ui/LinkArrow.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProfileLayout from "../../layouts/ProfileLayout.astro";
import "../../styles/post.css";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("projects");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<"projects">;
const entry = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
---

<ProfileLayout>
  <div slot="subtitle">
    <p class="text-lg text-text-light dark:text-text-dark text-balance">
      {entry.data.description}
    </p>
  </div>

  <div class="max-w-[65ch]">
    <h1 class="text-4xl md:text-5xl font-bold mb-6">{entry.data.title}</h1>

    <div class="prose dark:prose-invert lg:prose-md">
      <Content remarkPluginFrontmatter={remarkPluginFrontmatter} />
    </div>

    <Image
      src={entry.data.heroImage}
      alt={entry.data.title}
      class="my-8 rounded-lg shadow-lg max-w-xl mx-auto"
    />

    <div class="text-right">
      <LinkArrow href="/projects" class="mb-4" data-astro-preload>
        Back to all projects
      </LinkArrow>
    </div>
  </div>
</ProfileLayout>
