---
import Section from "../components/Section.astro";
import MainLayout from "../layouts/MainLayout.astro";
import BlogPosts from "../partials/BlogPosts.astro";
import JobExperience from "../partials/JobExperience.astro";
import Projects from "../partials/Projects.astro";
import Publications from "../partials/Publications.astro";
import GitHubGraph from "../components/external/GitHubGraph.astro";

let i = 0;
---

<MainLayout title="derock.dev - Fullstack Developer">
  <Section index={i++}>
    <p>
      Hi, I'm Derock, a <strong>sophomore at Duke</strong> studying Electrical Computer
      Engineering & CS. I specialize in <strong>embedded engineering</strong>,
      <strong>fullstack web development</strong>, and <strong
        >software development</strong
      >. I'm also an avid open-source contributor, with over 80 public projects
      on GitHub, and I take pride in building systems that emphasize
      performance, security, design, and reproducibility.
    </p>
  </Section>
  <Section title="Skills 🛠️" index={i++}>
    <div class="grid grid-cols-3">
      <div>
        <h3 class="font-semibold">tech</h3>
        <ul>
          <li>React (and ecosystem)</li>
          <li>Astro</li>
          <li>Tailwind CSS</li>
          <li>Node JS</li>
          <li>Docker</li>
          <li>Nix & NixOS</li>
          <li>embassy-rs</li>
          <li>esp-idf</li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold">languages</h3>
        <ul>
          <li>C & C++</li>
          <li>Rust</li>
          <li>TypeScript</li>
          <li>Python</li>
          <li>Java</li>
          <li>Bash</li>
          <li>SQL</li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold">tools</h3>
        <ul>
          <li>Git & GitHub</li>
          <li>Docker</li>
          <li>KiCad</li>
          <li>Neovim & VS Code</li>
          <li>Autodesk Fusion 360</li>
          <li>OnShape</li>
          <li>Figma</li>
        </ul>
      </div>
    </div>
  </Section>
  <Section title="Projects 🏗️" index={i++}>
    <Projects />
  </Section>
  <Section title="Publications 📚" index={i++}>
    <Publications />
  </Section>
  <Section title="Job Experience 👷" index={i++}>
    <JobExperience />
  </Section>
  <Section title="Recent Blog Posts 📝" index={i++}>
    <BlogPosts />
  </Section>
  <GitHubGraph username="ItzDerock" />
</MainLayout>
