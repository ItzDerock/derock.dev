---
import Section from "../components/Section.astro";
import MainLayout from "../layouts/MainLayout.astro";
import JobExperience from "../partials/JobExperience.astro";
import Projects from "../partials/Projects.astro";

let i = 0;
---

<MainLayout title="derock.dev - Fullstack Developer">
  <Section index={i++}>
    <p>
      Hi, I'm Derock, a <strong>high school senior</strong> specializing in <strong
        >fullstack web development</strong
      >, <strong>software development</strong>, and <strong
        >embedded programming</strong
      >. As an avid open-source contributor with over 60 public projects on
      GitHub, I focus on both design and performance . Fun fact: this site works
      even without JavaScript!
    </p>
  </Section>
  <Section title="Skills 🛠️" index={i++}>
    <div class="grid grid-cols-3">
      <div>
        <h3 class="font-semibold">tech</h3>
        <ul>
          <li>React</li>
          <li>Solid</li>
          <li>Next.js</li>
          <li>Astro</li>
          <li>Tailwind CSS</li>
          <li>Node JS</li>
          <li>Docker Swarm</li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold">languages</h3>
        <ul>
          <li>TypeScript</li>
          <li>C++</li>
          <li>Python</li>
          <li>Java</li>
          <li>Rust</li>
          <li>Bash</li>
          <li>SQL</li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold">tools</h3>
        <ul>
          <li>Git & GitHub</li>
          <li>Docker</li>
          <li>Turborepo</li>
          <li>Neovim & VS Code</li>
          <li>Autodesk Fusion 360</li>
          <li>OnShape</li>
          <li>Figma</li>
        </ul>
      </div>
    </div>
  </Section>
  <Section title="Projects 📚" index={i++}>
    <Projects />
  </Section>
  <Section title="Job Experience 👷" index={i++}>
    <JobExperience />
  </Section>
</MainLayout>
