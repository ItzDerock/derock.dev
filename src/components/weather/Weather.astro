---
import * as env from "astro:env/server";
import type { WeatherApiResponse } from "./openweathermap";
import { weatherCodeToAdjective } from "./utils";
import WeatherIcon from "./WeatherIcon.astro";

// Build the URL
const queryParams = new URLSearchParams();
queryParams.append("appid", env.OPENWEATHERMAP_KEY);
queryParams.append("units", "metric");

// lat/long should be integers
queryParams.append("lat", env.OPENWEATHERMAP_LAT.toFixed(0));
queryParams.append("lon", env.OPENWEATHERMAP_LON.toFixed(0));

// we only need current weather; options: current, minutely, hourly, daily, alerts
queryParams.append("exclude", "minutely,hourly,daily,alerts");

// Fetch the data (@11ty/eleventy-fetch caches response on the fs)
const weather = await fetch(
  "https://api.openweathermap.org/data/3.0/onecall?" + queryParams.toString(),
)
  .then((res) => res.json() as Promise<WeatherApiResponse>)
  .catch((err: Error) => {
    queryParams.delete("appid");
    console.error("Failed to fetch weather data! ", err, queryParams.entries);
    return null;
  });

const adj = weather
  ? weatherCodeToAdjective(weather?.current.weather[0].id)
  : null;

const feels = weather ? Math.round(weather.current.feels_like) : null;
---

{
  weather && adj && feels && (
    <span class="whitespace-pre" data-generated={new Date().toISOString()}>
      <span class="font-bold inline-block bg-linear-to-b from-text-light dark:from-text-dark to-text-light/60 dark:to-text-dark/60 via-text-light dark:via-text-dark text-transparent bg-clip-text">
        {adj}
      </span>{" "}
      <WeatherIcon
        code={weather.current.weather[0].id}
        isNight={
          !!(
            weather.current.sunrise &&
            weather.current.sunset &&
            (weather.current.dt > weather.current.sunset ||
              weather.current.dt < weather.current.sunrise)
          )
        }
      />
    </span>
  )
}
