---
import { fetchCurrentSong } from "../../pages/api/lastfm";
import { LastFMClient } from "./LastFMClient";

const initialData = await fetchCurrentSong().catch((err) => {
  console.log("[lastfm] Failed to fetch initial data, ", err);
  return null;
});
---

<LastFMClient
  initialValue={initialData}
  client:media="(min-width: 1024px)"
  client:idle
/>
