---
export interface Props {}

type APIResponse = {
  guilds: number;
  users: number;
};

import request from "@11ty/eleventy-fetch";
import { Icon } from "astro-icon/components";

const data = await request<APIResponse>(`https://graphs.poroscout.gg/stats`, {
  type: "json",
  duration: "1h",
});

const formatter = new Intl.NumberFormat("en-US");
---

<span class="inline-block">
  <Icon name="fa6-brands:discord" class="inline-block mb-1" />
  {formatter.format(data.guilds)} Servers
</span>

<span class="inline-block">
  <Icon name="tabler:user-filled" class="inline-block mb-1" />
  {formatter.format(data.users)} Users
</span>
