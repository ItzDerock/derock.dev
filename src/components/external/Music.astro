---
import { fetchCurrentTrack } from "~/pages/api/music";
import { LastFMClient } from "./MusicClient";

const initialData = await fetchCurrentTrack().catch((err) => {
  console.log("[lastfm] Failed to fetch initial data, ", err);
  return null;
});

console.log("Initial data fetched:", initialData);
---

<LastFMClient
  initialValue={initialData}
  client:media="(min-width: 1024px)"
  client:idle
/>
