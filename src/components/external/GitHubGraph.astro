---
import * as env from "astro:env/server";

interface Props {
  username: string;
}

const { username } = Astro.props;

type GithubResponseSuccess = {
  data: {
    user: {
      contributionsCollection: {
        contributionCalendar: {
          totalContributions: number;
          weeks: {
            contributionDays: {
              contributionLevel: number;
              contributionCount: number;
              date: string;
              weekday: string;
            }[];
          }[];
        };
      };
    };
  };
};

type GithubResponseFailure = {
  message: string;
  documentation_url: string;
  status: string;
};

async function getContributions(user: string) {
  const query = `
    query($user: String!) {
      user(login: $user) {
        contributionsCollection {
          contributionCalendar {
            totalContributions
            weeks {
              contributionDays {
                contributionLevel
                contributionCount
                date
                weekday
              }
            }
          }
        }
      }
    }
  `;

  const response = await fetch("https://api.github.com/graphql", {
    method: "POST",
    headers: {
      Authorization: `Bearer ${env.GITHUB_PAT}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ query, variables: { user } }),
  });

  const json = (await response.json()) as
    | GithubResponseSuccess
    | GithubResponseFailure;

  if ("data" in json)
    return json.data.user.contributionsCollection.contributionCalendar;

  console.error("[warn] Failed to fetch GitHub statistics");
  console.error(json);
  return null;
}

const data = await getContributions(username);
const weeks = data?.weeks;

function getColor(level: string) {
  switch (level) {
    case "FIRST_QUARTILE":
      return "fill-emerald-200 dark:fill-emerald-900";
    case "SECOND_QUARTILE":
      return "fill-emerald-400 dark:fill-emerald-700";
    case "THIRD_QUARTILE":
      return "fill-emerald-600 dark:fill-emerald-500";
    case "FOURTH_QUARTILE":
      return "fill-emerald-800 dark:fill-emerald-300";
    case "NONE":
    default:
      return "fill-slate-200 dark:fill-slate-800";
  }
}
---

{
  weeks && data && (
    <div class="flex flex-col items-center w-full max-w-full">
      <div class="w-full flex justify-center pb-2 overflow-x-auto">
        <svg
          viewBox={`0 0 ${weeks.length * 14} 100`}
          class="h-auto w-full max-w-187.5"
        >
          {weeks.map((week: any, weekIndex: number) => (
            <g transform={`translate(${weekIndex * 14}, 0)`}>
              {week.contributionDays.map((day: any) => (
                <rect
                  width="10"
                  height="10"
                  x="0"
                  y={day.weekday * 12}
                  class={getColor(day.contributionLevel)}
                  rx="2"
                  ry="2"
                >
                  <title>
                    {day.contributionCount} contributions on {day.date}
                  </title>
                </rect>
              ))}
            </g>
          ))}
        </svg>
      </div>

      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-2">
        {data.totalContributions} contributions in the last year
      </p>
    </div>
  )
}
