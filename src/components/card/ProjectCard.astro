---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import GitHub from "../external/GitHub.astro";
import NPM from "../external/NPM.astro";
import Card from "./Card.astro";

export interface Props {
  title: string;
  image: ImageMetadata | string;

  github?: string;
  npm?: string;

  href: string;
  index?: number;
}

const { image, title, href } = Astro.props;
---

<a
  href={href}
  target={href.startsWith("/") ? "_self" : "_blank"}
  data-sal="fade-up"
  style={{
    "transition-delay": `${(Astro.props.index ?? 0) * 100}ms`,
  }}
>
  <Card>
    <div class="flex flex-col md:flex-row gap-4">
      <div class="min-w-48">
        {
          typeof image === "string" ? (
            <img
              src={image}
              alt={title}
              class="md:max-w-48 object-cover rounded-md"
            />
          ) : (
            <Image
              src={image}
              alt={title}
              class="md:max-w-48 object-cover rounded-md"
              width={400}
            />
          )
        }
      </div>
      <div class="-mt-2">
        <h2 class="text-lg font-bold">{title}</h2>
        <div class="text-text-light dark:text-text-dark">
          <p>
            <slot />
          </p>
          <div class="text-sm space-x-2 mt-2 align-middle">
            {Astro.props.github && <GitHub repo={Astro.props.github} />}
            {Astro.props.npm && <NPM package={Astro.props.npm} />}
            <slot name="badges" />
          </div>
        </div>
      </div>
    </div>
  </Card>
</a>
