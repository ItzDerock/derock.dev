---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import * as env from "astro:env/client";
import profilePicture from "../assets/profile.jpeg";
import Music from "../components/external/Music.astro";
import LinkArrow from "../components/ui/LinkArrow.astro";
import Layout from "./Layout.astro";
import TwoColumn from "./TwoColumn.astro";

export interface Props {
  title?: string;
  description?: string;
  thumbnail?: string;
}

const { title, description, thumbnail } = Astro.props;
---

<Layout
  title={title ?? "derock.dev - Fullstack Developer"}
  description={description}
  thumbnail={thumbnail}
>
  <TwoColumn>
    <div class="mx-auto lg:mx-0 max-w-fit">
      <section
        class="flex flex-col gap-2 sticky top-12 lg:top-16 2xl:top-36 text-left items-baseline"
      >
        <div class="flex flex-row-reverse gap-2 sm:flex-col">
          <Image
            src={profilePicture}
            alt="Profile picture (picture of a cat)"
            class="size-30 w-xs:size-36 rounded-full"
          />

          <div class="flex flex-col gap-2">
            <h1 class="font-bold text-4xl sm:text-5xl">Derock Xie</h1>
            <slot name="subtitle" />
          </div>
        </div>

        <!-- links -->
        <div class="flex flex-col mt-2 xl:mt-[calc(80vh-35rem)]">
          <LinkArrow href="/" data-astro-preload>Home</LinkArrow>
          <LinkArrow href="https://derock.blog" target="_blank">Blog</LinkArrow>
          <LinkArrow href="/projects" data-astro-preload>
            All Projects
          </LinkArrow>
        </div>

        <!-- last.fm  -->
        <div
          class="lg:flex flex-col mt-2 gap-2 opacity-60 md:max-w-96 text-left"
        >
          <!-- todo: persist state here -->
          <Music server:defer transition:persist />
        </div>
      </section>
    </div>

    <div
      class="space-y-8 mb-24 leading-relaxed tracking-wide md:mx-auto lg:p-8 lg:-m-8"
    >
      <slot />

      <!-- git commit -->
      <div class="flex justify-between items-center">
        <span class="text-text-light/60 dark:text-text-dark/60 mx-auto">
          <a
            href={env.VERCEL_GIT_COMMIT_SHA
              ? `https://github.com/itzderock/derock.dev/commit/${env.VERCEL_GIT_COMMIT_SHA}`
              : "https://github.com/itzderock/derock.dev"}
            target="_blank"
            class="align-middle"
          >
            <Icon
              name="tabler:git-merge"
              class="size-4 transition-all inline-block"
            />
            <span class="sr-only">Git commit</span>

            {env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7) ?? "Unknown commit"}
          </a>
        </span>
      </div>
    </div>
  </TwoColumn>
</Layout>
