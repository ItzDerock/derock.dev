---
import { ClientRouter } from "astro:transitions";
import AOS from "../components/animations/AOS.astro";
import "../styles/global.css";
import Background from "../components/animations/Background.astro";

interface Props {
  title: string;
  description?: string;
  thumbnail?: string;
}

const { title, description, thumbnail } = Astro.props;
---

<!doctype html>
<html lang="en" class="min-h-full overflow-x-hidden dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="keywords" content="fullstack developer, derock xie" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="theme-color" content="#5f8785" />

    <!-- font -->
    <link rel="preconnect" href="https://fonts.cdnfonts.com" />
    <link href="https://fonts.cdnfonts.com/css/satoshi" rel="stylesheet" />

    <title>{title}</title>

    {/* thumbnail (large) */}
    <meta property="og:image" content={thumbnail ?? "/thumb.png"} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* title */}
    <meta property="og:title" content={title} />

    {/* description */}
    <meta
      name="description"
      content={description ??
        "Hi, I'm Derock Xie, a fullstack, software, and embedded developer studying Electrical Computer Engineering & CS at Duke University."}
    />
    <!--
    Light theme not yet ready
    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script> -->

    <ClientRouter />

    <!-- analytics -->
    <script
      defer
      is:inline
      data-domain="derock.dev"
      src="https://stats.derock.dev/js/script.js"></script>
  </head>
  <body
    class="bg-background-light text-foreground-light dark:text-foreground-dark dark:bg-background-dark min-h-full px-4 md:px-12 min-w-full"
  >
    <div class="streak left-12 w-36 h-225 -rotate-45 -translate-y-[50%]"></div>

    <div class="streak left-100 w-36 h-225 -rotate-45 -translate-y-[70%]"></div>

    <div
      class="streak right-0 bottom-0 size-44 blur-[120px] translate-x-[50%] translate-y-[50%]"
    >
    </div>

    <div class="-z-10 inset-0 fixed">
      <Background
        pixelSize={2.0}
        waveColor={[20 / 255, 55 / 255, 72 / 255]}
        enableMouseInteraction={false}
        backgroundColor={[0 / 255, 8 / 255, 20 / 255]}
        backgroundAlpha={1}
        waveAmplitude={0.367}
        waveSpeed={0.035}
      />
    </div>

    <slot />
    <style is:global>
      html {
        font-family: Satoshi, system-ui, sans-serif;
        font-display: swap;
      }

      .streak {
        position: fixed;
        background: hsl(199, 56%, 18%);
        border-radius: 50%;
        filter: blur(90px);
        mix-blend-mode: lighten;
        opacity: 1;
        transition: opacity 0.5s ease-in-out;
      }

      /* on screens bigger than 2000px, add a margin left to streaks */
      @media (min-width: 2000px) {
        .streak {
          margin-left: calc(50vw - 1100px);
        }
      }
    </style>
    <AOS />
  </body>
</html>
