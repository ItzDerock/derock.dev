---
import { Show } from "solid-js";
import ProjectCard from "../components/card/ProjectCard.astro";
import LinkArrow from "../components/ui/LinkArrow.astro";

export interface Props {
  showAll?: boolean;
}

type BlogPosts = {
  items: {
    title: string;
    description: string;
    pubDate: string;
    heroImage: string;
    tags: string[];
    link: string;
  }[];
};

// Cache for 1 hour, allow stale for 24 hours
Astro.response.headers.set(
  "Cache-control",
  "public, max-age=3600, stale-while-revalidate=86400",
);

let posts = await fetch("https://derock.blog/posts.json")
  .then((res) => res.json() as Promise<BlogPosts>)
  .then((res) =>
    res.items.sort(
      (a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime(),
    ),
  )
  .catch((err) => {
    console.error("[blog] Failed to fetch blog posts, ", err);
    return null;
  });

if (!Astro.props.showAll && posts) {
  posts = posts.slice(0, 3);
}
---

<div class="flex flex-col gap-y-2 -mt-2">
  <Show when={posts === null}>
    <p class="text-center py-16">
      Failed to fetch blog posts. Please try again later.
    </p>
  </Show>

  {
    posts?.map((item, idx) => (
      <ProjectCard
        image={"https://derock.blog/" + item.heroImage}
        title={item.title}
        href={"https://derock.blog" + item.link}
        index={idx}
      >
        {item.description}

        <small slot="badges">
          {new Date(item.pubDate).toLocaleDateString()}
        </small>
      </ProjectCard>
    ))
  }

  <div class="w-full flex justify-end">
    <LinkArrow href="https://derock.blog" target="_blank" class="ml-auto mr-0">
      View More (derock.blog)
    </LinkArrow>
  </div>
</div>
