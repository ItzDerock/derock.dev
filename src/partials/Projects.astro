---
import advancedStats from "../assets/projects/advanced-stats.png";
import discordHtmlTranscripts from "../assets/projects/discord-html-transcripts.png";
import discordMarkdownParser from "../assets/projects/discord-markdown-parser.png";
import hostforge from "../assets/projects/hostforge.png";
import mcstorage from "../assets/projects/mcstorage.png";
import poroscout from "../assets/projects/poroscout.webp";
import weatherStation from "../assets/projects/weather-station.webp";
import robotics from "../assets/projects/robotics.png";
import ProjectCard from "../components/card/ProjectCard.astro";
import PoroScout from "../components/external/PoroScout.astro";
import LinkArrow from "../components/ui/LinkArrow.astro";

let index = 0;

export interface Props {
  showAll?: boolean;
}
---

<div class="flex flex-col gap-y-2 -mt-2">
  <ProjectCard
    image={poroscout}
    title="PoroScout"
    href="/project/poroscout"
    index={index++}
  >
    PoroScout is a League of Legends companion bot that provides real-time game
    data, including live match stats, player profiles, champion statistics, and
    more. It is comprised of multiple microservices bundled into one monorepo,
    deployed using the Docker Swarm orchestrator.

    <PoroScout slot="badges" />
  </ProjectCard>
  <ProjectCard
    image={discordHtmlTranscripts}
    title="discord-html-transcripts"
    href="https://github.com/itzderock/discord-html-transcripts"
    npm="discord-html-transcripts"
    github="itzderock/discord-html-transcripts"
    index={index++}
  >
    An open-source package for developers looking to create Discord-style chat
    transcripts, allowing for a quick and easy way to archive and review
    conversations with a visually appealing format. It is built using StencilJS
    and React SSR.
  </ProjectCard>
  <ProjectCard
    image={hostforge}
    title="HostForge"
    href="https://github.com/ItzDerock/hostforge"
    github="itzderock/hostforge"
    index={index++}
  >
    A work-in-progress dashboard for managing fleets of servers, designed to
    provide a simple and intuitive interface for deploying and managing Docker
    swarm clusters. It can automatically build and bundle your code, automate
    SSL certificates, manage reverse proxies, instant rollbacks, and more.
  </ProjectCard>
  <ProjectCard
    image={mcstorage}
    title="MCStorage"
    href="https://web.archive.org/web/20220306183052/https://mcstorage.cloud/"
    index={index++}
  >
    MCStorage was a BaaS (Backup as a Service) designed for seamless integration
    with Minecraft and other game servers to facilitate easy data backups.
    Developed with a React.js frontend and a backend comprising a Fastify server
    and ZFS storage nodes, it was sold in 2022 and is now under new management.
  </ProjectCard>
  <ProjectCard
    image={weatherStation}
    title="DIY Weather Station"
    href="https://github.com/itzderock/weather-station"
    index={index++}
  >
    Low power, low cost ESP32-based weather station. Connects to an MQTT broker
    over NB-IoT cellular network for remote environments. Utilizes the
    ESP32-S3's Ultra low power co-processor and deep sleep states to maximize
    battery life. Collects temperature, humidity, pressure, wind speed, wind
    direction, rainfall, UV index, light level, and PM2.5 levels.
  </ProjectCard>

  {
    Astro.props.showAll ? (
      <>
        <ProjectCard
          image={advancedStats}
          title="Advanced Stats"
          href="https://github.com/itzderock/AdvancedStats"
          github="itzderock/AdvancedStats"
          index={index++}
        >
          Advanced Stats was a Discord bot that tracked server statistics and
          stored them in InfluxDB for later analysis. Users could view graphs
          and other charts related to their server, including voice channel
          usage, message counts, and more. The bot was built using Node.js and
          Discord.js.
        </ProjectCard>

        <ProjectCard
          image={discordMarkdownParser}
          title="discord-markdown-parser"
          href="https://github.com/itzderock/discord-markdown-parser"
          npm="discord-markdown-parser"
          github="itzderock/discord-markdown-parser"
          index={index++}
        >
          TypeScript implementation of a markdown parser, designed to turn
          discord-flavored markdown into an Abstract Syntax Tree (AST),
          supporting various markdown features such as links, quotes, code
          blocks, mentions, and emojis
        </ProjectCard>

        <ProjectCard
          image={robotics}
          title="vex-over-under"
          href="https://github.com/itzderock/vex-over-under"
          github="itzderock/vex-over-under"
          index={index++}
        >
          Robotics code for the 2023-2024 VEX Robotics season. PID, Pure
          Pursuit, and Boomerang algorithms. Custom MPEG video decoding pipeline
          with LVGL, runs at 40 fps. 3rd best programming score in the state.
        </ProjectCard>

        <div class="w-full flex flex-col justify-end">
          <LinkArrow href="https://github.com/itzderock" class="ml-auto mr-0">
            View even more on GitHub
          </LinkArrow>
          <LinkArrow href="/" class="ml-auto mr-0">
            Back Home
          </LinkArrow>
        </div>
      </>
    ) : (
      <div class="w-full flex justify-end">
        <LinkArrow href="/projects" class="ml-auto mr-0">
          View More Projects
        </LinkArrow>
      </div>
    )
  }
</div>
